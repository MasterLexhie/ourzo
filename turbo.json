{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ]
    },
    "docker:build": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "REDIS_HOST",
        "REDIS_PORT"
      ]
    },
    "lint": {
      "cache": false
    },
    "format:check": {
      "cache": false
    }
  }
}
