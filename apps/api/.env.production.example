# ===========================================
# Ourzo API - Production Environment Template
# This file documents production variables.
# Actual values should be provided via Docker secrets
# and managed service environment variables.
# ===========================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Exact web origin(s), comma-separated. Cookies use SameSite=Strict, so the
# web app and API must be served from the same site (ADR-010).
ALLOW_ORIGIN=${ALLOW_ORIGIN}
# Public web URL used in invitation links
WEB_APP_URL=${WEB_APP_URL}

# ----------------------------------------------------------------------------
# Database (Managed PostgreSQL - Neon, Supabase, RDS, etc.)
# ----------------------------------------------------------------------------
# Connection string with SSL for managed PostgreSQL
# Example: postgresql://user:password@host:5432/ourzo?schema=public&sslmode=require
DATABASE_URL=${DATABASE_URL}

# ----------------------------------------------------------------------------
# Authentication (Use strong secrets in production - min 32 chars)
# ----------------------------------------------------------------------------
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Redis (Managed Redis - Upstash, Redis Cloud, ElastiCache, etc.)
# ----------------------------------------------------------------------------
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
# Password provided via Docker secret (REDIS_PASSWORD_FILE)
# REDIS_PASSWORD=${REDIS_PASSWORD}

# ----------------------------------------------------------------------------
# Rate limiting (requests per window)
# ----------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_API_KEY_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------------------------------------
# Notes:
# - DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET, REDIS_HOST, REDIS_PASSWORD
#   should be set as environment variables or Docker secrets in production
# - Never commit actual secret values to version control
# - Use your platform's secret management (GitHub Actions secrets, AWS Secrets Manager, etc.)