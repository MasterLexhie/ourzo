# Application
NODE_ENV=development
PORT=3000
# Public URL of the web app, used to build shareable invitation links
WEB_APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ourzo_dev?schema=public

# Authentication
JWT_SECRET=your-super-secret-jwt-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=12

# Redis (configured in later phase)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD= (optional for local dev, required for production)

# Rate limiting (requests per window; defaults shown)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_API_KEY_MAX=120
RATE_LIMIT_WINDOW_MS=60000