{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!\\.pnpm/|@nestjs/(jwt|passport|mapped-types)/)"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "globalSetup": "<rootDir>/test/setup/global-setup.ts",
  "setupFiles": [
    "<rootDir>/test/setup/env.ts"
  ],
  "testTimeout": 30000,
  "collectCoverageFrom": [
    "src/**/*.service.ts"
  ],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "src/prisma/"
  ],
  "coverageDirectory": "coverage-e2e",
  "coverageThreshold": {
    "global": {
      "lines": 70
    }
  }
}
