# Normalise line endings in the repository.
* text=auto

# Files executed or parsed inside Linux containers must keep LF endings, even
# on Windows checkouts (core.autocrlf=true). A CRLF shell script fails with
# "/bin/sh^M: bad interpreter" and takes the Postgres container down with it.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
nginx.conf      text eol=lf
*.conf          text eol=lf
compose*.yaml   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.example    text eol=lf
*.env.example   text eol=lf
.husky/*        text eol=lf
