# ===========================================
# Ourzo - Docker Compose environment
# Copy to `.env` in the repository root. Docker Compose reads it automatically.
#
# The values below are DEVELOPMENT-ONLY placeholders. For production, use a
# separate file (e.g. `docker compose --env-file /secure/ourzo.env up -d`) with
# strong, unique secrets, and never commit it.
#
# Running the apps directly on the host (`pnpm dev`) uses apps/api/.env and
# apps/web/.env instead; see their .env.example files.
# ===========================================

# ----------------------------------------------------------------------------
# PostgreSQL  [required: POSTGRES_PASSWORD]
# ----------------------------------------------------------------------------
POSTGRES_USER=ourzo
POSTGRES_PASSWORD=dev_password
# Defaults: "ourzo" with compose.yaml, "ourzo_dev" with compose.dev.yaml
# POSTGRES_DB=

# ----------------------------------------------------------------------------
# API  [required: JWT_SECRET, JWT_REFRESH_SECRET; 32+ random chars each]
# Generate with: openssl rand -base64 48
# ----------------------------------------------------------------------------
JWT_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
# Local runs are plain HTTP, so the refresh cookie must not be Secure (browsers
# drop Secure cookies over HTTP except on localhost). Production (HTTPS) must
# use NODE_ENV=production, which is also the default when this is unset.
NODE_ENV=development
# Optional (defaults shown)
# JWT_ACCESS_TOKEN_EXPIRY=15m
# JWT_REFRESH_TOKEN_EXPIRY=7d
# BCRYPT_ROUNDS=12
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_DEFAULT_MAX=300
# RATE_LIMIT_API_KEY_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Public URL users open (used for CORS and invitation links)
ALLOW_ORIGIN=http://localhost:8080
WEB_APP_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Web  [optional]
# ----------------------------------------------------------------------------
# Host port for the web container
WEB_PORT=8080
# Leave empty: the SPA calls /api on its own origin through nginx.
# VITE_API_URL=

# ----------------------------------------------------------------------------
# Pre-built images  [optional, production]
# Use images published by GitHub Actions instead of building locally, e.g.
#   API_IMAGE=ghcr.io/masterlexhie/ourzo-api:sha-<commit>
#   MIGRATE_IMAGE=ghcr.io/masterlexhie/ourzo-api-migrate:sha-<commit>
#   WEB_IMAGE=ghcr.io/masterlexhie/ourzo-web:sha-<commit>
# ----------------------------------------------------------------------------
# API_IMAGE=
# MIGRATE_IMAGE=
# WEB_IMAGE=
