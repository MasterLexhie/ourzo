# ===========================================
# Ourzo - Root Environment Template
# Copy to .env and configure for local development
# ===========================================

# ----------------------------------------------------------------------------
# Database (used by docker-compose)
# ----------------------------------------------------------------------------
# Development database password
POSTGRES_PASSWORD=dev_password

# ----------------------------------------------------------------------------
# Backend (apps/api) - Copy apps/api/.env.example to apps/api/.env
# ----------------------------------------------------------------------------
# Application
NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:5173

# Database (local development)
DATABASE_URL=postgresql://ourzo:dev_password@localhost:5432/ourzo_dev?schema=public

# Authentication
JWT_SECRET=your-super-secret-jwt-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=12

# Redis (local development)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting (requests per window; defaults shown)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_API_KEY_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------------------------------------
# Frontend (apps/web) - Copy apps/web/.env.example to apps/web/.env
# ----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Production (Reference only - do not use for local development)
# ----------------------------------------------------------------------------
# For production, use Docker secrets and managed services.
# See apps/api/.env.production.example and docker-compose.prod.yml